---
const {
  title = "Choicebench Answers Pool",
  description = "A static answer library for Generative Engine Optimization, AI search visibility, and content strategy.",
  canonical = Astro.url.href,
  jsonLd = []
} = Astro.props;

const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Choicebench Answers Pool" />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #172033;
        --muted: #667085;
        --line: #d9dee8;
        --paper: #ffffff;
        --soft: #f5f7fb;
        --accent: #0f766e;
        --accent-2: #b45309;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: #fbfcfe;
      }

      a {
        color: inherit;
      }

      .shell {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
        background: rgba(251, 252, 254, 0.94);
        backdrop-filter: blur(14px);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        color: var(--muted);
        font-size: 14px;
      }

      .nav-links a {
        text-decoration: none;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 800;
        color: var(--accent);
      }

      .brand-mark {
        display: inline-grid;
        width: 30px;
        height: 30px;
        place-items: center;
        border-radius: 8px;
        color: #ffffff;
        background: var(--accent);
        font-size: 13px;
      }

      main {
        padding: 36px 0 72px;
      }

      h1 {
        margin: 12px 0 18px;
        font-size: 52px;
        line-height: 1.04;
        letter-spacing: 0;
      }

      h2 {
        margin: 0;
        font-size: 28px;
        line-height: 1.2;
        letter-spacing: 0;
      }

      h3 {
        margin: 0;
        font-size: 20px;
        line-height: 1.32;
      }

      p,
      li {
        font-size: 16px;
        line-height: 1.72;
      }

      .lede {
        max-width: 680px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.7;
      }

      .eyebrow,
      .meta,
      .card-meta,
      time {
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .eyebrow {
        margin: 0 0 10px;
        color: var(--accent);
        text-transform: uppercase;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 28px;
        align-items: end;
        padding: 28px 0 40px;
        border-bottom: 1px solid var(--line);
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
      }

      .hero-actions a {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #ffffff;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
      }

      .snapshot {
        display: grid;
        gap: 10px;
      }

      .snapshot div {
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--paper);
      }

      .snapshot span {
        display: block;
        font-size: 28px;
        font-weight: 800;
      }

      .snapshot p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 14px;
      }

      .latest,
      .language-section {
        padding-top: 38px;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 18px;
      }

      .section-head > p {
        max-width: 460px;
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      .post-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .card {
        display: block;
        min-height: 220px;
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--paper);
        text-decoration: none;
      }

      .card:hover,
      .post-row:hover {
        border-color: #9ca3af;
        background: #ffffff;
      }

      .card-meta {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
      }

      .card p,
      .post-row span {
        color: var(--muted);
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }

      .tags span {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 9px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.2;
      }

      .post-list {
        display: grid;
        gap: 10px;
      }

      .post-row {
        display: grid;
        grid-template-columns: 110px minmax(160px, 0.8fr) minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--paper);
        text-decoration: none;
      }

      article {
        max-width: 780px;
        margin: 0 auto;
        padding: 20px 0;
      }

      article h1 {
        font-size: 42px;
        line-height: 1.12;
      }

      article h2 {
        margin-top: 34px;
        margin-bottom: 12px;
      }

      article h3 {
        margin-top: 26px;
        margin-bottom: 10px;
      }

      article p,
      article li {
        font-size: 17px;
      }

      .article-tags {
        margin-bottom: 28px;
      }

      article :global(blockquote) {
        margin: 28px 0;
        padding: 18px 20px;
        border-left: 4px solid var(--accent-2);
        border-radius: 8px;
        background: var(--soft);
      }

      footer {
        padding: 28px 0;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 14px;
      }

      @media (max-width: 760px) {
        .nav {
          align-items: flex-start;
          flex-direction: column;
        }

        .hero,
        .post-grid,
        .post-row {
          grid-template-columns: 1fr;
        }

        h1 {
          font-size: 38px;
        }

        article h1 {
          font-size: 34px;
        }

        .section-head {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="shell nav">
        <a class="brand" href="/"><span class="brand-mark">CB</span><span>Choicebench Answers Pool</span></a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/#zh">中文</a>
          <a href="/#en">English</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer>
      <div class="shell">Static HTML answer pages for humans, search engines, and AI answer systems.</div>
    </footer>
  </body>
</html>
