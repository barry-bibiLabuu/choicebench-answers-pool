---
const {
  title = "Choicebench Answers Pool",
  description = "A static answer library for Generative Engine Optimization, AI search visibility, and content strategy.",
  canonical = Astro.url.href,
  jsonLd = []
} = Astro.props;

const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Choicebench Answers Pool" />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <style>
      :root {
        color-scheme: light;
        --ink: #111827;
        --muted: #5b6472;
        --line: #e5e7eb;
        --paper: #fffaf3;
        --accent: #9a5b13;
      }

      body {
        margin: 0;
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
        color: var(--ink);
        background: linear-gradient(180deg, #f8f5ef 0%, #ffffff 34%);
      }

      a {
        color: inherit;
      }

      .shell {
        width: min(960px, calc(100% - 32px));
        margin: 0 auto;
      }

      header {
        padding: 32px 0 20px;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
      }

      main {
        padding: 44px 0 72px;
      }

      h1 {
        max-width: 820px;
        margin: 12px 0 18px;
        font-size: clamp(38px, 7vw, 72px);
        line-height: 0.96;
        letter-spacing: -0.06em;
      }

      h2 {
        margin-top: 42px;
        font-size: 30px;
        letter-spacing: -0.03em;
      }

      h3 {
        margin-top: 28px;
        font-size: 22px;
      }

      p,
      li {
        font-size: 18px;
        line-height: 1.78;
      }

      .lede {
        max-width: 760px;
        color: var(--muted);
        font-size: 21px;
        line-height: 1.65;
      }

      .card {
        display: block;
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.76);
        text-decoration: none;
        box-shadow: 0 20px 50px rgba(17, 24, 39, 0.06);
      }

      .meta {
        font-family: ui-sans-serif, system-ui, sans-serif;
        color: var(--muted);
        font-size: 14px;
      }

      article {
        max-width: 780px;
      }

      article :global(blockquote) {
        margin: 28px 0;
        padding: 20px 24px;
        border-left: 5px solid var(--accent);
        border-radius: 18px;
        background: var(--paper);
      }

      footer {
        padding: 28px 0;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="shell">
        <a class="brand" href="/">Choicebench Answers Pool</a>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer>
      <div class="shell">Static HTML answer pages for humans, search engines, and AI answer systems.</div>
    </footer>
  </body>
</html>
