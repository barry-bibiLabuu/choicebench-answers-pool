---
// Generated by the GEO workbench: without a 404 page Cloudflare Pages answered
// every unknown address with the homepage and status 200 (a soft 404 that
// search engines index as the homepage).
import BaseLayout from "../layouts/BaseLayout.astro";

const BRAND = "领鸥国际教育";
const title = `页面不存在 · ${BRAND}留学问答库`;
---

<BaseLayout title={title} description="这个页面不存在或已经下架。" canonical={new URL("/404/", Astro.site).href}>
  <article>
    <h1>页面不存在</h1>
    <p>这个页面不存在或已经下架。</p>
    <p><a href="/">回到问答库首页</a></p>
  </article>
</BaseLayout>
