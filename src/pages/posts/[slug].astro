---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allPosts } from "../../lib/posts.js";

export async function getStaticPaths() {
  return allPosts().map((item) => {
    const frontmatter = item.frontmatter;
    const slug = item.slug;
    return {
      params: { slug },
      props: { post: item.module, frontmatter, slug, language: item.language, tags: item.tags }
    };
  });
}

const { post, frontmatter, slug, language, tags = [] } = Astro.props;
const { Content } = post;
const title = frontmatter.title;
const description = frontmatter.description;
const canonical = new URL(`/posts/${slug}/`, Astro.site).href;
const published = frontmatter.date;
const faqs = frontmatter.faq || [];

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: published,
  dateModified: published,
  mainEntityOfPage: canonical,
  author: {
    "@type": "Organization",
    name: "Choicebench"
  },
  publisher: {
    "@type": "Organization",
    name: "Choicebench",
    url: Astro.site?.toString()
  }
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: title, item: canonical }
  ]
};

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Choicebench",
  url: Astro.site?.toString()
};

const faqSchema = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer
        }
      }))
    }
  : null;

const jsonLd = [blogPosting, breadcrumb, organization, faqSchema].filter(Boolean);
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <article>
    <p class="meta">{language === "zh" ? "中文文章" : "English article"} · {published}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    {tags.length ? (
      <div class="tags article-tags">
        {tags.slice(0, 8).map((tag) => <span>{tag}</span>)}
      </div>
    ) : null}
    <Content />
  </article>
</BaseLayout>
