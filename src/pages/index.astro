---
import BaseLayout from "../layouts/BaseLayout.astro";

const postModules = import.meta.glob("../../content/posts/*.md", { eager: true });
const posts = Object.entries(postModules)
  .map(([path, mod]) => {
    const frontmatter = mod.frontmatter;
    return {
      title: frontmatter.title,
      description: frontmatter.description,
      date: frontmatter.date,
      slug: frontmatter.slug || path.split("/").pop()?.replace(/^\d{4}-\d{2}-\d{2}-/, "").replace(/\.md$/, "")
    };
  })
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));

const title = "Choicebench Answers Pool";
const description = "A static content library for Generative Engine Optimization, AI search visibility, and answer-first marketing pages.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section>
    <p class="brand">AI answer content library</p>
    <h1>Choicebench Answers Pool</h1>
    <p class="lede">
      Static, crawlable articles built for answer-first education, SEO discovery, and generative engine understanding.
    </p>
  </section>

  <section>
    <h2>Latest articles</h2>
    <div style="display: grid; gap: 18px;">
      {posts.map((post) => (
        <a class="card" href={`/posts/${post.slug}/`}>
          <p class="meta">{post.date}</p>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
