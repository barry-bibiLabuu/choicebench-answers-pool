---
// Generated by the GEO workbench (github_site_service.apply_answers_site): the
// brand's 问答库 homepage. Re-applying it overwrites this file.
import BaseLayout from "../layouts/BaseLayout.astro";
import { allPosts } from "../lib/posts.js";

const BRAND = "领鸥国际教育";
const OFFICIAL_URL = "https://www.lingoffers.com/";
const INTRO = "领鸥国际教育整理的留学申请问答：选校与专业、申请材料、时间线、政策与签证。每篇开头直接给出答案，事实注明官方来源和日期。";
const CATEGORIES = [
  { id: "major", name: "选校与专业", match: /选校|专业|怎么选|排名|大学|院校|项目|STEM|ECE|ISYE|AI|本科|硕士|博士/ },
  { id: "materials", name: "申请材料与文书", match: /材料|文书|PS|推荐信|清单|简历|CV|作品集|面试/ },
  { id: "timeline", name: "时间线与截止", match: /时间线|截止|早申|ED|EA|节点|倒推|冲刺/ },
  { id: "policy", name: "政策、签证与就业", match: /签证|政策|OPT|CPT|新规|离境|实习|就业|标化|SAT|ACT/ },
];

const posts = allPosts();
const zhPosts = posts.filter((post) => post.language === "zh");
const enPosts = posts.filter((post) => post.language !== "zh");
const text = (post) => `${post.title} ${post.description} ${post.tags.join(" ")}`;
const grouped = CATEGORIES.map((category) => ({ ...category, posts: zhPosts.filter((post) => category.match.test(text(post))) })).filter((category) => category.posts.length);
const others = zhPosts.filter((post) => !CATEGORIES.some((category) => category.match.test(text(post))));

const title = `${BRAND}留学问答库`;
const description = INTRO;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: canonical,
    inLanguage: "zh-CN",
    publisher: { "@type": "Organization", name: BRAND, url: OFFICIAL_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: zhPosts.slice(0, 30).map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/posts/${post.slug}/`, Astro.site).href,
      name: post.title,
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="hero">
    <div>
      <p class="eyebrow">留学问答库</p>
      <h1>每页回答一个留学申请问题</h1>
      <p class="lede">{INTRO}</p>
      <div class="hero-actions">
        <a href="#topics">按问题浏览</a>
        <a href="/about/">关于{BRAND}</a>
      </div>
    </div>
    <aside class="snapshot" aria-label="问答库概况">
      <div>
        <span>{zhPosts.length}</span>
        <p>篇问答</p>
      </div>
      <div>
        <span>{grouped.length}</span>
        <p>个分类</p>
      </div>
      <div>
        <span>{posts[0]?.date || "—"}</span>
        <p>最近更新</p>
      </div>
    </aside>
  </section>

  <section id="topics" class="latest">
    <div class="section-head">
      <div>
        <p class="eyebrow">分类</p>
        <h2>按问题浏览</h2>
      </div>
      <p>每篇开头直接给出答案，事实注明官方来源和日期，方便核对。</p>
    </div>
    <div class="tags article-tags">
      {grouped.map((category) => <a href={`#${category.id}`}>{category.name}（{category.posts.length}）</a>)}
      {others.length ? <a href="#others">其他问答（{others.length}）</a> : null}
    </div>
  </section>

  {grouped.map((category) => (
    <section id={category.id} class="language-section">
      <div class="section-head">
        <div>
          <h2>{category.name}</h2>
        </div>
      </div>
      <div class="post-grid">
        {category.posts.map((post) => (
          <a class="card" href={`/posts/${post.slug}/`}>
            <div class="card-meta"><time>{post.date}</time></div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  {others.length ? (
    <section id="others" class="language-section">
      <div class="section-head"><div><h2>其他问答</h2></div></div>
      <div class="post-grid">
        {others.map((post) => (
          <a class="card" href={`/posts/${post.slug}/`}>
            <div class="card-meta"><time>{post.date}</time></div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  {enPosts.length ? (
    <section id="en" class="language-section">
      <div class="section-head"><div><p class="eyebrow">English</p><h2>English answers</h2></div></div>
      <div class="post-grid">
        {enPosts.map((post) => (
          <a class="card" href={`/posts/${post.slug}/`}>
            <div class="card-meta"><time>{post.date}</time></div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  ) : null}
</BaseLayout>
