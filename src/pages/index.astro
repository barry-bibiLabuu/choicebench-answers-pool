---
import BaseLayout from "../layouts/BaseLayout.astro";
import { postsByLanguage } from "../lib/posts.js";

const { all: posts, zh: zhPosts, en: enPosts } = postsByLanguage();

const title = "Choicebench Answers Pool | Professional Bilingual Blog";
const description = "A clean bilingual blog for searchable education guides, AI-readable answers, and long-term content assets.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="hero">
    <div>
      <p class="eyebrow">Bilingual blog / 中英文知识库</p>
      <h1>Professional guides that are readable, searchable, and easy to cite.</h1>
      <p class="lede">
        Choicebench Answers Pool publishes concise English explainers and Chinese education guides with stable URLs, clear summaries, FAQ schema, and crawler-friendly structure.
      </p>
      <div class="hero-actions">
        <a href="#zh">中文文章</a>
        <a href="#en">English Articles</a>
      </div>
    </div>
    <aside class="snapshot" aria-label="Blog summary">
      <div>
        <span>{posts.length}</span>
        <p>Total posts</p>
      </div>
      <div>
        <span>{zhPosts.length}</span>
        <p>中文</p>
      </div>
      <div>
        <span>{enPosts.length}</span>
        <p>English</p>
      </div>
    </aside>
  </section>

  <section class="latest">
    <div class="section-head">
      <div>
        <p class="eyebrow">Latest</p>
        <h2>Latest articles / 最新文章</h2>
      </div>
      <p>Recent public articles with stable post URLs, language labels, summaries, tags, and SEO metadata.</p>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <a class="card" href={`/posts/${post.slug}/`}>
          <div class="card-meta">
            <span>{post.language === "zh" ? "中文" : "English"}</span>
            <time>{post.date}</time>
          </div>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          {post.tags.length ? (
            <div class="tags">
              {post.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
            </div>
          ) : null}
        </a>
      ))}
    </div>
  </section>

  <section id="zh" class="language-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Chinese</p>
        <h2>中文文章</h2>
      </div>
      <p>留学申请、案例判断、规划方法和可执行的决策文章。</p>
    </div>
    <div class="post-list">
      {zhPosts.map((post) => (
        <a class="post-row" href={`/posts/${post.slug}/`}>
          <time>{post.date}</time>
          <strong>{post.title}</strong>
          <span>{post.description}</span>
        </a>
      ))}
      {!zhPosts.length && <p class="muted">No Chinese posts yet.</p>}
    </div>
  </section>

  <section id="en" class="language-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">English</p>
        <h2>English Articles</h2>
      </div>
      <p>GEO, answer-first content, and AI-search visibility explainers.</p>
    </div>
    <div class="post-list">
      {enPosts.map((post) => (
        <a class="post-row" href={`/posts/${post.slug}/`}>
          <time>{post.date}</time>
          <strong>{post.title}</strong>
          <span>{post.description}</span>
        </a>
      ))}
      {!enPosts.length && <p class="muted">No English posts yet.</p>}
    </div>
  </section>
</BaseLayout>
